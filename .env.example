# Required for natural, context-aware AI turns. Key stays on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twitch streamer sign-in (create an app at https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# Dedicated Twitch bot account. Generate an OAuth token for this account with
# chat:read and chat:edit permissions. Keep this token private.
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH_TOKEN=

# Set a long random value before deploying. The default is local development only.
SESSION_SECRET=
PORT=3000
