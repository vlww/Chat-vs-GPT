# Required for natural, context-aware AI turns. Key stays on the server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Twitch app registration (one app serves streamer OAuth and the bot token)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# Dedicated bot account OAuth user token. Required scopes:
# user:bot user:read:chat user:write:chat
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
# Optional consistency check; the app reads this ID from token validation.
TWITCH_BOT_USER_ID=

# Set a long random value before deploying. The default is local development only.
SESSION_SECRET=
PORT=3000

# Optional for the frontend build when the Socket.IO backend has its own host.
# For Vercel, set this to the Render HTTPS service URL as a deployment variable.
VITE_SOCKET_ORIGIN=
