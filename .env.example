# AI for GPT's seat (and the simulated players in the demo). The key stays on the server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Public URL used in the bot's "grab a seat" links. Defaults to the origin of TWITCH_REDIRECT_URI.
PUBLIC_URL=

# Twitch app registration (one app serves streamer/suspect sign-in and the bot token)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback

# Optional dedicated bot account. Without it, the streamer's own sign-in reads and posts chat.
# Required scopes: user:bot user:read:chat user:write:chat
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_BOT_USER_ID=

# Set a long random value before deploying.
SESSION_SECRET=
PORT=3000

# Frontend build: the Socket.IO backend origin when it runs on a separate host (e.g. Render).
VITE_SOCKET_ORIGIN=
